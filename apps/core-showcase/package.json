{
  "name": "core-showcase",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vanilla TS + React showcase for @omnisat/lasereyes — `/` drives lasereyes-core directly (Alpine.js); `/react.html` drives @omnisat/lasereyes-react and exercises every hook.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "analyze": "ANALYZE=1 vite build && open dist/stats.html",
    "preview": "vite preview"
  },
  "dependencies": {
    "@omnisat/lasereyes-client": "workspace:*",
    "@omnisat/lasereyes-core": "workspace:*",
    "@omnisat/lasereyes-react": "workspace:*",
    "alpinejs": "^3.15.12",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/alpinejs": "^3.13.11",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^4.7.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "typescript": "5.8.3",
    "vite": "^5.4.0"
  }
}
