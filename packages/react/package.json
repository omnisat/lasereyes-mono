{
  "name": "@omnisat/lasereyes-react",
  "description": "React hooks and provider for LaserEyes — connect Bitcoin wallets and read on-chain data in React and Next.js apps.",
  "keywords": [
    "bitcoin",
    "ordinals",
    "bitcoin wallets",
    "react",
    "hooks",
    "web3",
    "dapps",
    "blockchain",
    "crypto"
  ],
  "homepage": "https://lasereyes.build",
  "bugs": {
    "url": "https://github.com/omnisat/lasereyes-mono/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omnisat/lasereyes-mono.git",
    "directory": "packages/react"
  },
  "license": "MIT",
  "private": false,
  "version": "0.0.79",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig.build.json && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:types": "vitest run --typecheck.enabled=true --typecheck.only",
    "typecheck": "vitest run --typecheck.enabled=true --typecheck.only",
    "test:watch": "vitest",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@nanostores/react": "^0.7.3",
    "@omnisat/lasereyes-core": "workspace:*",
    "nanostores": "^0.11.3"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.5.4",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "bip39": "^3.1.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonda": "^0.7.1",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "vite-plugin-dts": "^4.2.1",
    "vitest": "^2.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
