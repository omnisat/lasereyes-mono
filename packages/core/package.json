{
  "name": "@omnisat/lasereyes-core",
  "description": "Framework-agnostic Bitcoin wallet integration — declarative connectors, adapters, and reactive state for building Bitcoin and Ordinals dApps.",
  "keywords": [
    "bitcoin",
    "ordinals",
    "bitcoin wallets",
    "wallet connect",
    "web3",
    "dapps",
    "blockchain",
    "crypto"
  ],
  "homepage": "https://lasereyes.build",
  "bugs": {
    "url": "https://github.com/omnisat/lasereyes-mono/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omnisat/lasereyes-mono.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "private": false,
  "version": "0.1.0-next.1",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "unpkg": "./dist/lasereyes.umd.js",
  "jsdelivr": "./dist/lasereyes.umd.js",
  "files": [
    "dist",
    "src"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./actions": {
      "import": "./dist/actions.js",
      "types": "./dist/actions/index.d.ts"
    },
    "./query": {
      "import": "./dist/query.js",
      "types": "./dist/query/index.d.ts"
    },
    "./detection": {
      "import": "./dist/detection.js",
      "types": "./dist/detection/index.d.ts"
    },
    "./connectors": {
      "import": "./dist/connectors.js",
      "types": "./dist/connectors/index.d.ts"
    },
    "./connectors/unisat": {
      "import": "./dist/connectors/unisat.js",
      "types": "./dist/connectors/unisat.d.ts"
    },
    "./connectors/xverse": {
      "import": "./dist/connectors/xverse.js",
      "types": "./dist/connectors/xverse.d.ts"
    },
    "./connectors/leather": {
      "import": "./dist/connectors/leather.js",
      "types": "./dist/connectors/leather.d.ts"
    },
    "./connectors/okx": {
      "import": "./dist/connectors/okx.js",
      "types": "./dist/connectors/okx.d.ts"
    },
    "./connectors/oyl": {
      "import": "./dist/connectors/oyl.js",
      "types": "./dist/connectors/oyl.d.ts"
    },
    "./connectors/phantom": {
      "import": "./dist/connectors/phantom.js",
      "types": "./dist/connectors/phantom.d.ts"
    },
    "./connectors/orange": {
      "import": "./dist/connectors/orange.js",
      "types": "./dist/connectors/orange.d.ts"
    },
    "./connectors/op-net": {
      "import": "./dist/connectors/op-net.js",
      "types": "./dist/connectors/op-net.d.ts"
    },
    "./connectors/tokeo": {
      "import": "./dist/connectors/tokeo.js",
      "types": "./dist/connectors/tokeo.d.ts"
    },
    "./connectors/keplr": {
      "import": "./dist/connectors/keplr.js",
      "types": "./dist/connectors/keplr.d.ts"
    },
    "./adapters/unisat": {
      "import": "./dist/adapters/unisat.js",
      "types": "./dist/adapters/unisat.d.ts"
    },
    "./adapters/xverse": {
      "import": "./dist/adapters/xverse.js",
      "types": "./dist/adapters/xverse.d.ts"
    },
    "./adapters/leather": {
      "import": "./dist/adapters/leather.js",
      "types": "./dist/adapters/leather.d.ts"
    },
    "./adapters/okx": {
      "import": "./dist/adapters/okx.js",
      "types": "./dist/adapters/okx.d.ts"
    },
    "./adapters/oyl": {
      "import": "./dist/adapters/oyl.js",
      "types": "./dist/adapters/oyl.d.ts"
    },
    "./adapters/phantom": {
      "import": "./dist/adapters/phantom.js",
      "types": "./dist/adapters/phantom.d.ts"
    },
    "./adapters/orange": {
      "import": "./dist/adapters/orange.js",
      "types": "./dist/adapters/orange.d.ts"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:esm && pnpm build:umd",
    "build:esm": "tsc && vite build && node scripts/inline-client-types.mjs",
    "build:umd": "vite build --mode umd",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@leather.io/rpc": "^2.20.3",
    "@omnisat/lasereyes-client": "workspace:*",
    "@types/node": "^22.7.7",
    "@types/tiny-async-pool": "^2.0.3",
    "eslint": "^9.30.0",
    "globals": "^15.9.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "sonda": "^0.7.1",
    "typescript": "5.8.3",
    "vite": "^5.4.1",
    "vite-plugin-dts": "^4.2.1"
  },
  "dependencies": {
    "@nanostores/query": "^0.3.4",
    "@scure/base": "^1.2.0",
    "@scure/btc-signer": "^1.5.0",
    "eventemitter3": "^5.0.1",
    "nanostores": "^0.11.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
